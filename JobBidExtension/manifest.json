{
  "manifest_version": 3,
  "name": "JobBid Autofill",
  "version": "3.9.71",
  "description": "Autofill job applications on any site from saved candidate profiles, AI answers, a work schedule and an application tracker.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://ipwho.is/*",
    "https://ipapi.co/*",
    "https://api.ipify.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobBid Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "content.js",
        "panel.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "exclude_matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the job application on this page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
